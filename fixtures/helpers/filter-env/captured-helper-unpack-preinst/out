src_install () 
{ 
    local d="${ED}/usr/share/porttest/helper-unpack";
    mkdir -p "${d}" || die;
    cp -a "${WORKDIR}/file0600" "${WORKDIR}/file0777" "${WORKDIR}/sub0700" "${WORKDIR}/sub0775" "${d}/" || die;
    ( cd "${WORKDIR}" || die;
    stat -c '%a %n' file0600 file0777 sub0700 sub0700/nested0640 sub0775 > "${d}/modes.txt" ) || die
}
