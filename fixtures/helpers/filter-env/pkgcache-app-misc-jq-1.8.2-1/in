tc-has-tls () 
{ 
    local base="${T}/test-tc-tls";
    cat <<-EOF > "${base}.c"
int foo(int *i) {
static __thread int j = 0;
return *i ? j : *i;
}
EOF

    local flags
    case $1 in 
        -s)
            flags="-S"
        ;;
        -c)
            flags="-c"
        ;;
        -l)

        ;;
        -*)
            die "Usage: tc-has-tls [-c|-l] [toolchain prefix]"
        ;;
    esac;
    case "${CHOST}" in 
        *-darwin*)
            : ${flags:=-dynamiclib}
        ;;
        *)
            : ${flags:=-fPIC -shared -Wl,-z,defs}
        ;;
    esac;
    [[ $1 == -* ]] && shift;
    $(tc-getCC "$@") ${flags} "${base}.c" -o "${base}" >&/dev/null;
    local ret=$?;
    rm -f "${base}"*;
    return ${ret}
}
