pre_source_sandbox () 
{ 
    export SANDBOX_ON=1;
    export SANDBOX_PREDICT="";
    export SANDBOX_READ="${EBUILD}:${BASH_SOURCE[1]}:${SANDBOX_LOG}";
    export SANDBOX_WRITE="${SANDBOX_LOG}:/dev/null";
    [[ ${PORTAGE_DEBUG} != 1 ]] || export SANDBOX_DEBUG=1;
    local repo_location;
    for repo_location in "${PORTAGE_ECLASS_LOCATIONS[@]}";
    do
        local potential_location="${repo_location}/eclass";
        if [[ -d ${potential_location} ]]; then
            SANDBOX_READ+=":${potential_location}";
        fi;
    done;
    function adddeny () 
    { 
        die "External commands disallowed while sourcing ebuild: ${FUNCNAME}"
    };
    function addpredict () 
    { 
        die "External commands disallowed while sourcing ebuild: ${FUNCNAME}"
    };
    function addread () 
    { 
        die "External commands disallowed while sourcing ebuild: ${FUNCNAME}"
    };
    function addwrite () 
    { 
        die "External commands disallowed while sourcing ebuild: ${FUNCNAME}"
    };
    readonly SANDBOX_{ALLOW,ACTIVE,DENY,DEBUG,ON,PREDICT,READ,WRITE}
}
prefixify_ro () 
{ 
    if [[ -e $1 ]]; then
        local f=${1##*/};
        cp "$1" "${T}" || die "failed to copy file";
        local x="${T}"/${f};
        if grep -qs @GENTOO_PORTAGE_EPREFIX@ "${x}"; then
            eprefixify "${T}"/${f} 1>&2;
        else
            hprefixify "${T}"/${f} 1>&2;
        fi;
        echo "${x}";
    else
        die "$1 does not exist";
    fi
}
