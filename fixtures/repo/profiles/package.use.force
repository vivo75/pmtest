# repo-level package.use.force: force-enables "forceflag" for
# dev-libs/pkgusemaskforcepkg via a bare cat/pkg atom (Portage drops
# wildcard atoms such as `*/pkgusemaskforcepkg` in repo profiles --
# UseManager._parse_file_to_dict allows them only for user config --
# so the entry must be a plain atom; backlog #341 S5).
dev-libs/pkgusemaskforcepkg forceflag

# dev-libs/deepusedepfchild is installed +flip; this entry force-enables
# flip in its *effective* USE too, so the `[-flip]` its installed parent
# (built -flip) evaluates `[flip=]` into is unfixable -- no pool can
# satisfy it and no autounmask flip can change it. Real hard-aborts
# (the shrunk #111 live shape, where the profile forced +wayland);
# arm A differs only in that its package.use entry IS autounmaskable
# (#132 arm D).
dev-libs/deepusedepfchild flip
