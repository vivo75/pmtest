    local extra_args=();
    [[ ${VERIFY_SIG_OPENPGP_KEY_REFRESH} == yes ]] || extra_args+=(-R);
    if [[ -n ${VERIFY_SIG_OPENPGP_KEYSERVER+1} ]]; then
        [[ ${VERIFY_SIG_METHOD} == openpgp ]] || die "${FUNCNAME}: VERIFY_SIG_OPENPGP_KEYSERVER is not supported";
        extra_args+=(--keyserver "${VERIFY_SIG_OPENPGP_KEYSERVER}");
    fi;
    addpredict /run/user;
    local filename=${file##*/};
    [[ ${file} == - ]] && filename='(stdin)';
