edo () 
{ 
    local a out regex='[] '\''"\|&;()<>!{}*[?^$`]|^[#~]|[=:]~';
    [[ $# -ge 1 ]] || die "edo: at least one argument needed";
    if [[ ${EAPI} = 7 ]]; then
        out=" $*";
    else
        for a in "$@";
        do
            [[ ${a} =~ ${regex} || ! ${a} =~ ^[[:print:]]+$ ]] && a=${a@Q};
            out+=" ${a}";
        done;
    fi;
    einfon;
    printf '%s\n' "${out:1}" 1>&2;
    "$@" || die -n "Failed to run command: ${1}"
}
edob () 
{ 
    local message;
    local log_name;
    while true; do
        case "${1}" in 
            -l | -m)
                [[ $# -lt 2 ]] && die "Must provide an argument to ${1}";
                case "${1}" in 
                    -l)
                        log_name="${2}"
                    ;;
                    -m)
                        message="${2}"
                    ;;
                esac;
                shift 2
            ;;
            *)
                break
            ;;
        esac;
    done;
    [[ -z ${message} ]] && message="Running $@";
    [[ -z ${log_name} ]] && log_name="$(basename ${1})";
    local log_file="${T}/${log_name}.log";
    ebegin "${message}";
    "$@" &> "${log_file}";
    local ret=$?;
    if ! eend $ret; then
        cat "${log_file}";
        die -n "Command \"$@\" failed with exit status $ret";
    fi
}
