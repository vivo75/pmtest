verify-sig_src_unpack () 
{ 
    if use verify-sig; then
        local f suffix found;
        local distfiles=() signatures=() nosigfound=() straysigs=();
        for f in ${A};
        do
            found=;
            for suffix in .asc .sig .minisig .sigstore;
            do
                if [[ ${f} == *${suffix} ]]; then
                    signatures+=("${f}");
                    found=sig;
                    break;
                else
                    if has "${f}${suffix}" ${A}; then
                        distfiles+=("${f}");
                        found=dist+sig;
                        break;
                    fi;
                fi;
            done;
            if [[ ! -n ${found} ]]; then
                nosigfound+=("${f}");
            fi;
        done;
        if [[ ${#nosigfound[@]} -gt 0 ]]; then
            eerror "The following distfiles lack detached signatures:";
            for f in "${nosigfound[@]}";
            do
                eerror "  ${f}";
            done;
            die "Unsigned distfiles found";
        fi;
        for f in "${signatures[@]}";
        do
            if ! has "${f%.*}" "${distfiles[@]}"; then
                straysigs+=("${f}");
            fi;
        done;
        if [[ ${#straysigs[@]} -gt 0 ]]; then
            eerror "The following signatures do not match any distfiles:";
            for f in "${straysigs[@]}";
            do
                eerror "  ${f}";
            done;
            die "Unused signatures found";
        fi;
        for f in "${signatures[@]}";
        do
            verify-sig_verify_detached "${DISTDIR}/${f%.*}" "${DISTDIR}/${f}";
        done;
    fi;
    default_src_unpack
}
